generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  mobileNumber     String            @unique
  pinHash          String
  role             Role              @default(USER)
  name             String
  age              Int?
  gender           String?
  conditions       String?
  startDate        DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  foodLogs         FoodLog[]
  medicalRecords   MedicalRecord[]
  nutritionTargets NutritionTarget[]

  @@map("users")
}

model NutritionTarget {
  id             String   @id @default(cuid())
  userId         String
  effectiveFrom  DateTime
  targetCarbs    Float
  targetProteins Float
  targetFats     Float
  targetCalories Float
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveFrom])
  @@map("nutrition_targets")
}

model FoodItem {
  id            String    @id @default(cuid())
  itemName      String    @unique
  carbohydrates Float
  proteins      Float
  fats          Float
  calories      Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  foodLogs      FoodLog[]

  @@map("food_items")
}

model MedicalRecord {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weight    Float
  height    Float
  bmi       Float
  bpLow     Float
  bpHigh    Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("medical_records")
}

model FoodLog {
  id               String   @id @default(cuid())
  userId           String
  foodItemId       String
  date             DateTime @default(now())
  dishName         String
  quantityGms      Float
  carbs            Float
  proteins         Float
  fats             Float
  calories         Float
  proteinCarbRatio Float?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem         FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([foodItemId])
  @@map("food_logs")
}

